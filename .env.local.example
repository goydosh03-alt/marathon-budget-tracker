# Скопіюй цей файл у .env.local і встав свої значення.
# .env.local НЕ потрапляє в git (захищено .gitignore).

# --- Supabase (візьмеш у Supabase → Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Серверні ключі (додамо пізніше, поки лиши порожніми) ---
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
EXCHANGE_RATE_API_KEY=
